{
  "name": "ptcg-server",
  "version": "0.0.3",
  "description": "Browser-safe Pokemon TCG card engine and local PrizeMap puzzle simulator",
  "main": "browser/browser.js",
  "types": "browser/browser.d.ts",
  "scripts": {
    "test:client": "node scripts/test-client.cjs",
    "test:cards": "node scripts/test-card-regressions.cjs",
    "test:client:cards": "node scripts/test-client.cjs --cards",
    "compile": "tsc -p tsconfig.browser.json",
    "build": "npm run compile",
    "check": "tsc -p tsconfig.browser.json --noEmit",
    "test": "npm run test:cards"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/jasmine": "^2.8.17",
    "@types/node": "^12.12.54",
    "@typescript-eslint/eslint-plugin": "^5.22.0",
    "@typescript-eslint/parser": "^5.22.0",
    "eslint": "^8.14.0",
    "jasmine": "^3.9.0",
    "jasmine-ts": "~0.4.0",
    "nyc": "15.1.0",
    "ts-node": "~7.0.0",
    "typescript": "~4.9.5"
  },
  "exports": {
    ".": {
      "types": "./browser/browser.d.ts",
      "default": "./browser/browser.js"
    },
    "./client": {
      "types": "./browser/client/index.d.ts",
      "default": "./browser/client/index.js"
    }
  }
}

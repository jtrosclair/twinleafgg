{
  "compilerOptions": {
    "skipLibCheck": true,
    "target": "es2017",
    "module": "commonjs",
    "lib": [
      "dom",
      "es2019"
    ],
    "declaration": true,
    "outDir": "output",
    "rootDirs": [
      "./src"
    ],
    "removeComments": false,
    "preserveConstEnums": true,
    "resolveJsonModule": true,
    "noEmitOnError": false, // CHANGED
    "allowSyntheticDefaultImports": true,
    "strict": true, // CHANGED
    "noUnusedLocals": false, // CHANGED
    "typeRoots": [
      "node_modules/@types"
    ],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
{
  "name": "ptcg-play",
  "engines": {
    "node": ">=20.9.0"
  },
  "version": "0.0.3",
  "scripts": {
    "ng": "ng",
    "start": "npm run prepare:simulator && node scripts/run-angular.cjs serve --configuration=local",
    "build": "npm run prepare:simulator && node scripts/run-angular.cjs build --configuration=production && node scripts/finalize-client-build.cjs",
    "build:development": "npm run prepare:simulator && node scripts/run-angular.cjs build --configuration=development && node scripts/finalize-client-build.cjs",
    "build:local": "npm run prepare:simulator && node scripts/run-angular.cjs build --configuration=local && node scripts/finalize-client-build.cjs",
    "prepare:simulator": "node scripts/audit-simulator-assets.cjs && node scripts/optimize-ui-assets.cjs --check && node ../ptcg-server/scripts/build-browser.cjs && node scripts/build-client-assets.cjs",
    "assets:optimize": "node scripts/optimize-ui-assets.cjs",
    "assets:check": "node scripts/optimize-ui-assets.cjs --check",
    "assets:audit": "node scripts/audit-simulator-assets.cjs",
    "test": "npm run prepare:simulator && node ../tools/test-client-services.cjs && node scripts/optimize-ui-assets.spec.cjs",
    "test:assets": "node scripts/optimize-ui-assets.spec.cjs && node --test scripts/audit-simulator-assets.spec.cjs scripts/static-resources.spec.cjs",
    "test:karma": "node scripts/run-angular.cjs test --watch=false --browsers=ChromeHeadless",
    "test:finalizer": "node scripts/finalize-client-build.spec.cjs",
    "test:package": "node --test scripts/package-client-build.spec.cjs scripts/report-client-bundle.spec.cjs ../tools/check-simulator-package.spec.cjs",
    "report:bundle": "node scripts/report-client-bundle.cjs --baseline ../docs/simulator-bundle-results.json --output ../docs/simulator-bundle-results.json",
    "typecheck": "tsc -p src/tsconfig.app.json --noEmit",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^12.2.9",
    "@angular/cdk": "^12.2.9",
    "@angular/common": "~12.2.9",
    "@angular/compiler": "~12.2.9",
    "@angular/core": "~12.2.9",
    "@angular/forms": "~12.2.9",
    "@angular/material": "^12.2.9",
    "@angular/platform-browser": "~12.2.9",
    "@angular/platform-browser-dynamic": "~12.2.9",
    "@angular/router": "~12.2.9",
    "@ng-dnd/core": "^1.0.0",
    "@ng-dnd/multi-backend": "^1.0.0",
    "@ng-dnd/sortable": "^1.0.3",
    "@ngneat/until-destroy": "^8.1.4",
    "@ngx-translate/core": "^13.0.0",
    "pako": "2.1.0",
    "ptcg-server": "file:../ptcg-server",
    "rxjs": "~6.5.3",
    "tslib": "^2.0.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~12.2.9",
    "@angular-eslint/builder": "12.5.0",
    "@angular-eslint/eslint-plugin": "12.5.0",
    "@angular-eslint/eslint-plugin-template": "12.5.0",
    "@angular-eslint/template-parser": "12.5.0",
    "@angular/cli": "~12.2.9",
    "@angular/compiler-cli": "~12.2.9",
    "@types/jasmine": "~3.6.0",
    "@types/node": "^12.11.1",
    "@typescript-eslint/eslint-plugin": "4.28.2",
    "@typescript-eslint/parser": "4.28.2",
    "eslint": "^7.26.0",
    "jasmine-core": "~3.6.0",
    "karma": "~6.3.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "typescript": "~4.3.5"
  }
}

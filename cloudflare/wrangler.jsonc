{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prizemap-simulator-assets",
  "account_id": "b81d26988ea846268f2a6a58256d51db",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "sim-static.prizemap.app",
      "zone_id": "a28801dbf6979c44fd0baaff48c2dc6f",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../ptcg-play/cloudflare-public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/index.html",
      "/sandbox-viewer",
      "/sandbox-viewer/",
      "/table",
      "/table/*",
      "/card-images",
      "/releases/*/index.html",
      "/releases/*/card-images"
    ]
  }
}

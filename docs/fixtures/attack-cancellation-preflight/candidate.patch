+import { Card } from '../card/card';
+import { AttackEffect, CheckAttackCancellationEffect } from '../effects/game-effects';
+import { Player } from '../state/player';
+import { State } from '../state/state';
+import { StoreLike } from '../store-like';
+
+interface Scope {
+  state: State;
+  store: StoreLike;
+  player: Player;
+  checked: Map<Card, Set<Function>>;
+  precheckedAttack: AttackEffect;
+  touched: Map<AttackEffect, Map<Card, Set<Function>> | undefined>;
+}
+let scopes = new WeakMap<State, Scope[]>();
+// Keep transient dispatch bookkeeping off effects and serialized game state.
+const checkedEffects = new WeakMap<AttackEffect, Map<Card, Set<Function>>>();
+
+type CancellationHandler = (store: StoreLike, state: State, effect: CheckAttackCancellationEffect) => State;
+/** Accept executable preflight ownership only from a trusted card prototype. */
+export function attackCancellationHandler(card: Card): CancellationHandler | undefined {
+  if (Object.prototype.hasOwnProperty.call(card, 'reduceEffect') ||
+      Object.prototype.hasOwnProperty.call(card, 'reduceAttackCancellationEffect')) return undefined;
+  let proto = Object.getPrototypeOf(card), depth = 0, effectDepth: number | undefined;
+  let handlerDepth: number | undefined, handler: CancellationHandler | undefined;
+  while (proto && proto !== Object.prototype) {
+    if (effectDepth === undefined && Object.prototype.hasOwnProperty.call(proto, 'reduceEffect')) effectDepth = depth;
+    if (handlerDepth === undefined && Object.prototype.hasOwnProperty.call(proto, 'reduceAttackCancellationEffect')) {
+      const descriptor = Object.getOwnPropertyDescriptor(proto, 'reduceAttackCancellationEffect');
+      if (typeof descriptor?.value !== 'function') return undefined;
+      handlerDepth = depth; handler = descriptor.value;
+    }
+    proto = Object.getPrototypeOf(proto); depth++;
+  }
+  return handlerDepth !== undefined && effectDepth !== undefined && handlerDepth <= effectDepth ? handler : undefined;
+}
+
+export function beginAttackCancellationScope(state: State, store: StoreLike, player: Player, checked: Map<Card, Set<Function>>, precheckedAttack: AttackEffect): Scope {
+  const scope = { state, store, player, checked, precheckedAttack, touched: new Map<AttackEffect, Map<Card, Set<Function>> | undefined>() };
+  const stack = scopes.get(state) ?? []; stack.push(scope); scopes.set(state, stack);
+  return scope;
+}
+
+export function inheritAttackCancellationScope(state: State, store: StoreLike, effect: AttackEffect): void {
+  const stack = scopes.get(state), scope = stack && [...stack].reverse().find(item => item.store === store);
+  if (!scope || scope.player !== effect.player) return;
+  if (!scope.touched.has(effect)) scope.touched.set(effect, checkedEffects.get(effect));
+  checkedEffects.set(effect, scope.checked);
+}
+
+export function endAttackCancellationScope(scope: Scope): void {
+  for (const [effect, previous] of scope.touched) {
+    if (previous) checkedEffects.set(effect, previous); else checkedEffects.delete(effect);
+  }
+  const stack = scopes.get(scope.state); if (!stack) return;
+  const i = stack.indexOf(scope); if (i >= 0) stack.splice(i, 1);
+  if (!stack.length) scopes.delete(scope.state);
+}
+
+export function clearAttackCancellationScopes(state: State, store: StoreLike): void {
+  const stack = scopes.get(state) ?? [];
+  for (const scope of stack.filter(item => item.store === store).reverse()) {
+    for (const [effect, previous] of scope.touched) {
+      if (previous) checkedEffects.set(effect, previous); else checkedEffects.delete(effect);
+    }
+  }
+  const remaining = stack.filter(item => item.store !== store);
+  if (remaining.length) scopes.set(state, remaining); else scopes.delete(state);
+}
+
+/** Track the card and the owning reducer separately: a copied attack may
+ * share a marker source with a different, native cancellation reducer. */
+export function markAttackCancellationChecked(checked: Map<Card, Set<Function>>, card: Card, handler: Function): boolean {
+  let handlers = checked.get(card);
+  if (!handlers) checked.set(card, handlers = new Set());
+  if (handlers.has(handler)) return false;
+  handlers.add(handler);
+  return true;
+}
+
+export function wasAttackCancellationChecked(effect: AttackEffect, card: Card, handler: Function): boolean {
+  return checkedEffects.get(effect)?.get(card)?.has(handler) ?? false;
+}
+
+/** Only the exact outer event was checked before the cancellation prompt. */
+export function isAttackLegalityPrechecked(state: State, store: StoreLike, effect: AttackEffect): boolean {
+  return (scopes.get(state) ?? []).some(scope => scope.store === store && scope.precheckedAttack === effect);
+}

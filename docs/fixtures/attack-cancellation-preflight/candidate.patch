+import { GameError } from '../../game-error';
+import { GameMessage } from '../../game-message';
+import { AttackEffect } from '../effects/game-effects';
+import { MarkerConstants } from '../markers/marker-constants';
+import { State } from '../state/state';
+import { StoreLike } from '../store-like';
+import { preflightCopiedOpponentAttacks } from './copy-attack-delegation';
+
+/** Run hard prohibitions before cancellation prompts or attack-owned effects. */
+export function checkAttackLegality(store: StoreLike, state: State, effect: AttackEffect): State {
+  if (effect.preventDefault) return state;
+  if (effect.attack && effect.player.marker.hasMarker(MarkerConstants.CLEAR_VISION_GX_LOCK)
+    && (effect.attack.gxAttack === true ||
+      (typeof effect.attack.name === 'string' && effect.attack.name.includes('-GX')))) {
+    throw new GameError(GameMessage.CANNOT_USE_ATTACK);
+  }
+  return preflightCopiedOpponentAttacks(store, state, effect);
+}
